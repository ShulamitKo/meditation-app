# ─── Required ────────────────────────────────────────
# Anthropic Claude API — for generating meditation text
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional ────────────────────────────────────────
# ElevenLabs TTS — for voice narration
# Get key at: https://elevenlabs.io (free tier available)
# Without this key, audio generation is skipped
ELEVENLABS_API_KEY=sk_...

# Google Gemini API — for generating calming images (feature in development)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ─── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
